<Window x:Class="SecureBank.Client.Dashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SecureBank - Dashboard"
        Height="800"
        Width="1300"
        WindowStartupLocation="CenterScreen"
        Background="#121212"
        WindowState="Maximized">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Opacity" Value="1.0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,5"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.3"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border" BorderThickness="0,0,0,3" BorderBrush="Transparent" Background="Transparent" Padding="20,10">
                            <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#4FC3F7"/>
                                <Setter TargetName="Border" Property="Background" Value="#1E1E1E"/>
                                <Setter Property="Foreground" Value="#4FC3F7"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Foreground" Value="Gray"/>
                                <Setter TargetName="Border" Property="Background" Value="Transparent"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#333333"/>
            <Setter Property="RowBackground" Value="#1E1E1E"/>
            <Setter Property="AlternatingRowBackground" Value="#252526"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#2D2D30"/>
                        <Setter Property="Foreground" Value="#4FC3F7"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0D47A1">
            <Grid>
                <TextBlock Text="SecureBank" FontSize="22" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="30,0,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,30,0">
                    <TextBlock x:Name="lblUser" Foreground="White" FontSize="14" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <Button Content="LOGOUT" Height="35" Width="100" Background="#D32F2F" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnLogout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" x:Name="mainTabs" Background="#121212" BorderThickness="0">

            <!-- TELLER TAB -->
            <TabItem Header="Teller Operations" x:Name="tabTeller">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="400" MinWidth="300" MaxWidth="600"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#1E1E1E" CornerRadius="8" Padding="20">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>

                                <TextBlock Text="CREATE CUSTOMER" FontSize="16" FontWeight="Bold" Foreground="#4FC3F7" Margin="0,0,0,15"/>
                                <TextBlock Text="First Name" Foreground="#AAAAAA" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtCustFirst" Height="35" Margin="0,0,0,10"/>
                                <TextBlock Text="Last Name" Foreground="#AAAAAA" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtCustLast" Height="35" Margin="0,0,0,10"/>
                                <TextBlock Text="ID Number" Foreground="#AAAAAA" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtCustId" Height="35" Margin="0,0,0,10"/>
                                <TextBlock Text="Email" Foreground="#AAAAAA" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtCustEmail" Height="35" Margin="0,0,0,10"/>
                                <TextBlock Text="Phone" Foreground="#AAAAAA" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtCustPhone" Height="35" Margin="0,0,0,10"/>
                                <TextBlock Text="Address" Foreground="#AAAAAA" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtCustAddress" Height="35" Margin="0,0,0,15"/>
                                <Button x:Name="btnCreateCustomer" Content="CREATE CUSTOMER" Height="40" Background="#00BCD4" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnCreateCustomer_Click"/>
                                <TextBlock x:Name="lblCustomerMessage" Foreground="#4CAF50" TextWrapping="Wrap" Margin="0,10,0,0"/>

                                <Separator Background="#333333" Margin="0,20,0,20"/>

                                <TextBlock Text="OPEN ACCOUNT" FontSize="16" FontWeight="Bold" Foreground="#4FC3F7" Margin="0,0,0,15"/>
                                <TextBlock Text="Customer ID" Foreground="#AAAAAA" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtOpenAccCustId" Height="35" Margin="0,0,0,10"/>
                                <TextBlock Text="Account Type" Foreground="#AAAAAA" Margin="0,0,0,5"/>
                                <ComboBox x:Name="cboOpenAccType" Height="35" Margin="0,0,0,10">
                                    <ComboBoxItem Content="Savings"/>
                                    <ComboBoxItem Content="Cheque"/>
                                    <ComboBoxItem Content="Credit"/>
                                </ComboBox>
                                <TextBlock Text="Initial Deposit (R)" Foreground="#AAAAAA" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtOpenAccDeposit" Height="35" Margin="0,0,0,15"/>
                                <Button x:Name="btnOpenAccount" Content="OPEN ACCOUNT" Height="40" Background="#3F51B5" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnOpenAccount_Click"/>
                                <TextBlock x:Name="lblOpenAccMessage" Foreground="#4CAF50" TextWrapping="Wrap" Margin="0,10,0,0"/>

                                <Separator Background="#333333" Margin="0,20,0,20"/>

                                <TextBlock Text="ACCOUNT LOOKUP" FontSize="16" FontWeight="Bold" Foreground="#4FC3F7" Margin="0,0,0,15"/>
                                <TextBlock Text="Account Number" Foreground="#AAAAAA" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtLookupAccount" Height="35" Margin="0,0,0,15" TextChanged="Field_Changed"/>
                                <Button x:Name="btnLookup" Content="LOOKUP" Height="40" Background="#2196F3" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,0,20" Click="btnLookup_Click"/>

                                <Border Background="#2D2D30" CornerRadius="5" Padding="15" Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Text="Customer" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,5"/>
                                        <TextBlock x:Name="lblCustomerName" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>

                                        <TextBlock Text="Account Type" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,5"/>
                                        <TextBlock x:Name="lblAccountType" Foreground="White" FontSize="14" Margin="0,0,0,15"/>

                                        <TextBlock Text="Balance" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,5"/>
                                        <TextBlock x:Name="lblBalance" Foreground="#4CAF50" FontSize="28" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock x:Name="lblLookupMessage" Foreground="#FF5252" TextWrapping="Wrap" Margin="0,0,0,15"/>

                                <Separator Background="#333333" Margin="0,10,0,20"/>

                                <TextBlock Text="TRANSACTIONS" FontSize="16" FontWeight="Bold" Foreground="#4FC3F7" Margin="0,0,0,15"/>
                                <TextBlock Text="Amount (R)" Foreground="#AAAAAA" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtAmount" Height="35" Margin="0,0,0,15" TextChanged="Field_Changed"/>

                                <TextBlock Text="Destination (transfer only)" Foreground="#AAAAAA" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtDestination" Height="35" Margin="0,0,0,20" TextChanged="Field_Changed"/>

                                <Button x:Name="btnDeposit" Content="DEPOSIT" Height="40" Background="#4CAF50" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,0,10" Cursor="Hand" Click="btnDeposit_Click"/>
                                <Button x:Name="btnWithdraw" Content="WITHDRAW" Height="40" Background="#FF9800" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,0,10" Cursor="Hand" Click="btnWithdraw_Click"/>
                                <Button x:Name="btnTransfer" Content="TRANSFER" Height="40" Background="#2196F3" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnTransfer_Click"/>
                                <TextBlock x:Name="lblTransactionResult" Foreground="#4CAF50" TextWrapping="Wrap" Margin="0,15,0,0"/>

                                <Separator Background="#333333" Margin="0,20,0,20"/>

                                <TextBlock Text="APPLY FOR LOAN" FontSize="16" FontWeight="Bold" Foreground="#4FC3F7" Margin="0,0,0,15"/>
                                <TextBlock Text="Customer ID" Foreground="#AAAAAA" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtLoanCustId" Height="35" Margin="0,0,0,15"/>
                                <TextBlock Text="Amount (R)" Foreground="#AAAAAA" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtLoanAmount" Height="35" Margin="0,0,0,15"/>
                                <TextBlock Text="Interest Rate (e.g. 0.10)" Foreground="#AAAAAA" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtLoanRate" Height="35" Margin="0,0,0,15"/>
                                <TextBlock Text="Term (Months)" Foreground="#AAAAAA" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtLoanTerm" Height="35" Margin="0,0,0,20"/>
                                <Button x:Name="btnApplyLoan" Content="SUBMIT APPLICATION" Height="40" Background="#9C27B0" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnApplyLoan_Click"/>
                                <TextBlock x:Name="lblLoanMessage" Foreground="#4CAF50" TextWrapping="Wrap" Margin="0,15,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="2" Background="#1E1E1E" CornerRadius="8" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="RECENT TRANSACTIONS" FontSize="16" FontWeight="Bold" Foreground="#4FC3F7" Margin="0,0,0,15"/>
                            <DataGrid Grid.Row="1" x:Name="dgTransactions">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="150"/>
                                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount}" Width="120"/>
                                    <DataGridTextColumn Header="Balance After" Binding="{Binding BalanceAfter}" Width="130"/>
                                    <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="160"/>
                                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Grid.Row="2" x:Name="lblTransactionMessage" Foreground="#4CAF50" Margin="0,10,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- MANAGER TAB -->
            <TabItem Header="Manager Approvals" x:Name="tabManager">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="PENDING LOAN APPLICATIONS" FontSize="20" FontWeight="Bold" Foreground="#4FC3F7" Margin="0,0,0,15"/>

                    <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="8" Padding="10">
                        <DataGrid x:Name="dgPendingLoans">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Loan ID" Binding="{Binding LoanId}" Width="100"/>
                                <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*"/>
                                <DataGridTextColumn Header="Amount (R)" Binding="{Binding Amount}" Width="150"/>
                                <DataGridTextColumn Header="Interest" Binding="{Binding Rate}" Width="120"/>
                                <DataGridTextColumn Header="Term" Binding="{Binding Term}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,15,0,20">
                        <Button Content="REFRESH" Width="150" Height="40" Background="#2196F3" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,15,0" Click="btnRefreshLoans_Click"/>
                        <Button Content="APPROVE SELECTED" Width="180" Height="40" Background="#4CAF50" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,15,0" Click="btnApproveLoan_Click"/>
                        <Button Content="REJECT SELECTED" Width="180" Height="40" Background="#F44336" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnRejectLoan_Click"/>
                        <TextBlock x:Name="lblManagerMessage" Foreground="#4CAF50" VerticalAlignment="Center" Margin="20,0,0,0" FontSize="14"/>
                    </StackPanel>

                    <TextBlock Grid.Row="3" Text="ACTIVE LOANS" FontSize="20" FontWeight="Bold" Foreground="#4FC3F7" Margin="0,10,0,15"/>
                    <Border Grid.Row="4" Background="#1E1E1E" CornerRadius="8" Padding="10">
                        <DataGrid x:Name="dgActiveLoans">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Loan ID" Binding="{Binding LoanId}" Width="100"/>
                                <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*"/>
                                <DataGridTextColumn Header="Amount (R)" Binding="{Binding Amount}" Width="150"/>
                                <DataGridTextColumn Header="Remaining Balance (R)" Binding="{Binding RemainingBalance}" Width="180"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,20,0,0">
                        <TextBlock Text="CLOSE ACCOUNT:" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <TextBox x:Name="txtCloseAccountNumber" Width="200" Height="35" Margin="0,0,15,0"/>
                        <Button Content="CLOSE ACCOUNT" Width="180" Height="35" Background="#D32F2F" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnCloseAccount_Click"/>
                        <TextBlock x:Name="lblCloseAccountMessage" Foreground="#4CAF50" VerticalAlignment="Center" Margin="20,0,0,0" FontSize="14"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ADMIN TAB -->
            <TabItem Header="System Admin" x:Name="tabAdmin">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="MANAGE SYSTEM USERS" FontSize="20" FontWeight="Bold" Foreground="#4FC3F7" Margin="0,0,0,15"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock Text="Username:" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="txtManageUsername" Width="200" Height="35" Margin="0,0,15,0"/>
                        <Button Content="TOGGLE ACTIVE STATUS" Width="200" Height="35" Background="#FF9800" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnToggleUser_Click"/>
                        <TextBlock x:Name="lblManageUserMessage" Foreground="#4CAF50" VerticalAlignment="Center" Margin="20,0,0,0"/>
                    </StackPanel>

                    <Separator Grid.Row="2" Background="#333333" Margin="0,0,0,20"/>

                    <TextBlock Grid.Row="3" Text="SYSTEM AUDIT LOG" FontSize="20" FontWeight="Bold" Foreground="#4FC3F7" Margin="0,0,0,10"/>

                    <Border Grid.Row="4" Background="#1E1E1E" CornerRadius="8" Padding="10">
                        <DataGrid x:Name="dgAuditLog">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="User" Binding="{Binding User}" Width="150"/>
                                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="200"/>
                                <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*"/>
                                <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}" Width="200"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,15,0,0">
                        <Button Content="REFRESH LOG" Width="150" Height="40" Background="#2196F3" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnRefreshAuditLog_Click"/>
                        <Button Content="EXPORT TO CSV" Width="150" Height="40" Background="#4CAF50" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="15,0,0,0" Click="btnExportCsv_Click"/>
                        <TextBlock x:Name="lblAdminMessage" Foreground="#4CAF50" VerticalAlignment="Center" Margin="20,0,0,0" FontSize="14"/>
                    </StackPanel>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>