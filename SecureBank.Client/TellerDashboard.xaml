<Window x:Class="SecureBank.Client.TellerDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SecureBank - Teller Dashboard"
        Height="700"
        Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0D47A1">
            <Grid>
                <TextBlock Text="SecureBank - Teller"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="20,0,0,0"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,20,0">
                    <TextBlock x:Name="lblUser"
                               Foreground="White"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Margin="0,0,15,0"/>
                    <Button Content="LOGOUT"
                            Height="35"
                            Width="100"
                            Background="#D32F2F"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="btnLogout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#2D2D30" CornerRadius="5" Padding="15">
                <StackPanel>
                    <TextBlock Text="ACCOUNT LOOKUP"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#4FC3F7"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="Account Number" Foreground="White" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtLookupAccount"
                             Height="35"
                             FontSize="14"
                             Padding="5"
                             Margin="0,0,0,10"
                             TextChanged="Field_Changed"/>

                    <Button x:Name="btnLookup"
                            Content="LOOKUP"
                            Height="40"
                            Background="#4FC3F7"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="0,0,0,20"
                            Click="btnLookup_Click"/>

                    <TextBlock Text="Customer" Foreground="Gray" FontSize="12"/>
                    <TextBlock x:Name="lblCustomerName" Foreground="White" FontSize="14" Margin="0,0,0,15"/>

                    <TextBlock Text="Account Type" Foreground="Gray" FontSize="12"/>
                    <TextBlock x:Name="lblAccountType" Foreground="White" FontSize="14" Margin="0,0,0,15"/>

                    <TextBlock Text="Balance" Foreground="Gray" FontSize="12"/>
                    <TextBlock x:Name="lblBalance"
                               Foreground="#4FC3F7"
                               FontSize="24"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="lblLookupMessage"
                               Foreground="Red"
                               TextWrapping="Wrap"
                               Margin="0,15,0,0"/>

                    <Border Background="#1E1E1E" Height="1" Margin="0,20,0,20"/>

                    <TextBlock Text="TRANSACTIONS"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#4FC3F7"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="Amount (R)" Foreground="White" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtAmount"
                             Height="35"
                             FontSize="14"
                             Padding="5"
                             Margin="0,0,0,10"
                             TextChanged="Field_Changed"/>

                    <TextBlock Text="Destination (transfer only)" Foreground="Gray" FontSize="12" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtDestination"
                             Height="35"
                             FontSize="14"
                             Padding="5"
                             Margin="0,0,0,15"
                             TextChanged="Field_Changed"/>

                    <Button x:Name="btnDeposit"
                            Content="DEPOSIT"
                            Height="35"
                            Background="#4CAF50"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Margin="0,0,0,8"
                            Cursor="Hand"
                            Click="btnDeposit_Click"/>

                    <Button x:Name="btnWithdraw"
                            Content="WITHDRAW"
                            Height="35"
                            Background="#FF9800"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Margin="0,0,0,8"
                            Cursor="Hand"
                            Click="btnWithdraw_Click"/>

                    <Button x:Name="btnTransfer"
                            Content="TRANSFER"
                            Height="35"
                            Background="#2196F3"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="btnTransfer_Click"/>

                    <TextBlock x:Name="lblTransactionResult"
                               Foreground="LightGreen"
                               TextWrapping="Wrap"
                               Margin="0,15,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="#2D2D30" CornerRadius="5" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="RECENT TRANSACTIONS"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#4FC3F7"
                               Margin="0,0,0,15"/>

                    <DataGrid Grid.Row="1"
                              x:Name="dgTransactions"
                              Background="#252526"
                              Foreground="White"
                              RowBackground="#2D2D30"
                              AlternatingRowBackground="#333337"
                              GridLinesVisibility="None"
                              HeadersVisibility="Column"
                              AutoGenerateColumns="True"
                              IsReadOnly="True"/>

                    <TextBlock Grid.Row="2"
                               x:Name="lblTransactionMessage"
                               Foreground="LightGreen"
                               Margin="0,10,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>