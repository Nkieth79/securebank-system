<Window x:Class="SecureBank.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SecureBank - Login"
        Height="400"
        Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1E1E1E">

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="350">

            <TextBlock Text="SecureBank"
                       FontSize="36"
                       FontWeight="Bold"
                       Foreground="#4FC3F7"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>

            <TextBlock Text="Online Banking System"
                       FontSize="14"
                       Foreground="Gray"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,40"/>

            <TextBlock Text="Username" Foreground="White" Margin="0,0,0,5"/>
            <TextBox x:Name="txtUsername"
                     Height="35"
                     FontSize="14"
                     Padding="5"
                     Margin="0,0,0,15"/>

            <TextBlock Text="Password" Foreground="White" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtPassword"
                         Height="35"
                         FontSize="14"
                         Padding="5"
                         Margin="0,0,0,20"/>

            <Button x:Name="btnLogin"
                    Content="LOGIN"
                    Height="45"
                    FontSize="16"
                    FontWeight="Bold"
                    Background="#4FC3F7"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="btnLogin_Click"/>

            <TextBlock x:Name="lblMessage"
                       Foreground="Red"
                       HorizontalAlignment="Center"
                       Margin="0,15,0,0"
                       TextWrapping="Wrap"/>

        </StackPanel>
    </Grid>
</Window>